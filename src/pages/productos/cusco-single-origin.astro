---
import Page from '../../layouts/Page.astro';

const product = {
  name: "Cusco Single Origin",
  origin: "Cusco, Quillabamba",
  roast: "Tostado medio",
  price: 42,
  weight: "250g",
  score: 86,
  altitude: "1,600 msnm",
  process: "Lavado",
  variety: "Typica, Bourbon",
  harvest: "Junio - Septiembre",
  notes: ["Chocolate", "Nuez", "Caramelo"],
  description: "Un café excepcional cultivado en las laderas de Quillabamba, Cusco. A 1,600 metros de altura, los granos desarrollan un perfil dulce y equilibrado con notas predominantes de chocolate y nuez. Procesado mediante el método lavado, este café ofrece una taza limpia con cuerpo medio y un final prolongado de caramelo.",
  brewing: [
    { method: "V60 Pour Over", grind: "Medio-fino", ratio: "15g : 250ml", temp: "92°C", time: "3:00 min" },
    { method: "Prensa Francesa", grind: "Grueso", ratio: "18g : 270ml", temp: "93°C", time: "4:00 min" },
    { method: "AeroPress", grind: "Fino", ratio: "15g : 180ml", temp: "85°C", time: "2:00 min" },
  ],
  images: [
    "https://images.unsplash.com/photo-1559056199-641a0ac8b55e?w=700&h=700&fit=crop",
    "https://images.unsplash.com/photo-1511537190424-bbbab87ac5eb?w=400&h=400&fit=crop",
    "https://images.unsplash.com/photo-1504630083234-14187a9df0f5?w=400&h=400&fit=crop",
  ]
};

const relatedProducts = [
  {
    name: "Cajamarca Reserva",
    roast: "Tostado oscuro",
    price: 48,
    image: "https://images.unsplash.com/photo-1587734195503-904fca47e0e9?w=400&h=400&fit=crop",
  },
  {
    name: "Junín Orgánico",
    roast: "Tostado ligero",
    price: 45,
    image: "https://images.unsplash.com/photo-1611854779393-1b2da9d400fe?w=400&h=400&fit=crop",
  },
  {
    name: "Blend Casa",
    roast: "Tostado medio",
    price: 38,
    image: "https://images.unsplash.com/photo-1514432324607-a09d9b4aefda?w=400&h=400&fit=crop",
  },
];
---

<Page title={`${product.name} - Origen Café`}>
  <section class="product-detail">
    <div class="container">
      <nav class="breadcrumb">
        <a href="/">Inicio</a>
        <span>/</span>
        <a href="/productos">Productos</a>
        <span>/</span>
        <span>{product.name}</span>
      </nav>

      <div class="product-grid">
        <div class="product-gallery">
          <div class="gallery-main">
            <img src={product.images[0]} alt={product.name} class="gallery-main-img" />
            <span class="badge badge-popular gallery-badge">Más vendido</span>
          </div>
          <div class="gallery-thumbs">
            {product.images.map((img, i) => (
              <button class={`gallery-thumb ${i === 0 ? 'active' : ''}`}>
                <img src={img} alt={`${product.name} vista ${i + 1}`} />
              </button>
            ))}
          </div>
        </div>

        <div class="product-details">
          <span class="product-origin-label">{product.origin}</span>
          <h1 class="product-title">{product.name}</h1>

          <div class="product-rating">
            <div class="stars">★★★★★</div>
            <span class="rating-text">4.9 (127 reseñas)</span>
          </div>

          <div class="product-price-row">
            <span class="detail-price">S/ {product.price}</span>
            <span class="detail-weight">{product.weight}</span>
          </div>

          <p class="product-description">{product.description}</p>

          <div class="flavor-notes">
            <h4>Notas de sabor</h4>
            <div class="notes-tags">
              {product.notes.map(note => (
                <span class="note-tag">{note}</span>
              ))}
            </div>
          </div>

          <div class="product-specs">
            <div class="spec-item">
              <span class="spec-label">Origen</span>
              <span class="spec-value">{product.origin}</span>
            </div>
            <div class="spec-item">
              <span class="spec-label">Altitud</span>
              <span class="spec-value">{product.altitude}</span>
            </div>
            <div class="spec-item">
              <span class="spec-label">Proceso</span>
              <span class="spec-value">{product.process}</span>
            </div>
            <div class="spec-item">
              <span class="spec-label">Puntaje</span>
              <span class="spec-value">{product.score} pts</span>
            </div>
            <div class="spec-item">
              <span class="spec-label">Variedad</span>
              <span class="spec-value">{product.variety}</span>
            </div>
            <div class="spec-item">
              <span class="spec-label">Cosecha</span>
              <span class="spec-value">{product.harvest}</span>
            </div>
          </div>

          <div class="product-actions">
            <div class="quantity-selector">
              <button class="qty-btn" aria-label="Reducir cantidad">-</button>
              <span class="qty-value">1</span>
              <button class="qty-btn" aria-label="Aumentar cantidad">+</button>
            </div>
            <button class="btn btn-primary add-to-cart-btn">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
              Agregar al Carrito
            </button>
          </div>

          <div class="product-perks">
            <div class="perk">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--sage)" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
              Envío gratis en pedidos +S/ 80
            </div>
            <div class="perk">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--sage)" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
              Tostado fresco cada semana
            </div>
            <div class="perk">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--sage)" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
              Comercio directo con productores
            </div>
          </div>
        </div>
      </div>

      <div class="brewing-section">
        <h2>Recomendaciones de Preparación</h2>
        <div class="brewing-recs">
          {product.brewing.map(b => (
            <div class="brewing-rec-card card">
              <h4>{b.method}</h4>
              <div class="rec-specs">
                <div class="rec-spec">
                  <span class="rec-label">Molienda</span>
                  <span class="rec-value">{b.grind}</span>
                </div>
                <div class="rec-spec">
                  <span class="rec-label">Dosis</span>
                  <span class="rec-value">{b.ratio}</span>
                </div>
                <div class="rec-spec">
                  <span class="rec-label">Temperatura</span>
                  <span class="rec-value">{b.temp}</span>
                </div>
                <div class="rec-spec">
                  <span class="rec-label">Tiempo</span>
                  <span class="rec-value">{b.time}</span>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>

      <div class="related-section">
        <h2>También te puede gustar</h2>
        <div class="related-grid">
          {relatedProducts.map(rp => (
            <div class="related-card card">
              <img src={rp.image} alt={rp.name} class="related-img" loading="lazy" />
              <div class="related-info">
                <h4>{rp.name}</h4>
                <span class="related-roast">{rp.roast}</span>
                <span class="related-price">S/ {rp.price}</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>
</Page>

<style>
  .product-detail {
    padding: 6rem 0 4rem;
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: var(--text-light);
    margin-bottom: 2rem;
  }

  .breadcrumb a {
    color: var(--text-light);
    text-decoration: none;
  }

  .breadcrumb a:hover { color: var(--accent); }

  .product-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    margin-bottom: 4rem;
  }

  .gallery-main {
    position: relative;
    border-radius: var(--radius);
    overflow: hidden;
    margin-bottom: 1rem;
  }

  .gallery-main-img {
    width: 100%;
    height: 500px;
    object-fit: cover;
  }

  .gallery-badge {
    position: absolute;
    top: 16px;
    left: 16px;
  }

  .gallery-thumbs {
    display: flex;
    gap: 0.75rem;
  }

  .gallery-thumb {
    border: 2px solid transparent;
    border-radius: var(--radius-sm);
    overflow: hidden;
    cursor: pointer;
    padding: 0;
    background: none;
    transition: border-color 0.3s;
  }

  .gallery-thumb.active,
  .gallery-thumb:hover {
    border-color: var(--accent);
  }

  .gallery-thumb img {
    width: 80px;
    height: 80px;
    object-fit: cover;
  }

  .product-origin-label {
    display: inline-block;
    color: var(--accent);
    font-weight: 600;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 0.5rem;
  }

  .product-title {
    font-size: 2rem;
    margin-bottom: 0.75rem;
  }

  .product-rating {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }

  .stars {
    color: var(--accent);
    font-size: 1rem;
    letter-spacing: 2px;
  }

  .rating-text {
    font-size: 0.85rem;
    color: var(--text-light);
  }

  .product-price-row {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
  }

  .detail-price {
    font-family: 'Lora', serif;
    font-size: 2rem;
    font-weight: 700;
    color: var(--primary);
  }

  .detail-weight {
    font-size: 0.9rem;
    color: var(--text-light);
    background: var(--bg-alt);
    padding: 0.2rem 0.6rem;
    border-radius: 50px;
  }

  .product-description {
    color: var(--text-light);
    line-height: 1.8;
    margin-bottom: 1.5rem;
    font-size: 0.95rem;
  }

  .flavor-notes {
    margin-bottom: 1.5rem;
  }

  .flavor-notes h4 {
    font-size: 0.88rem;
    margin-bottom: 0.6rem;
    color: var(--primary);
  }

  .notes-tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .note-tag {
    background: linear-gradient(135deg, rgba(200,121,65,0.12) 0%, rgba(218,160,109,0.12) 100%);
    color: var(--primary-light);
    font-size: 0.82rem;
    font-weight: 600;
    padding: 0.4rem 1rem;
    border-radius: 50px;
    border: 1px solid rgba(200,121,65,0.2);
  }

  .product-specs {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.5rem;
    margin-bottom: 2rem;
    padding: 1.25rem;
    background: var(--bg-alt);
    border-radius: var(--radius);
  }

  .spec-item {
    display: flex;
    justify-content: space-between;
    padding: 0.4rem 0;
    font-size: 0.85rem;
  }

  .spec-label {
    color: var(--text-light);
  }

  .spec-value {
    font-weight: 600;
    color: var(--primary);
  }

  .product-actions {
    display: flex;
    gap: 1rem;
    align-items: center;
    margin-bottom: 1.5rem;
  }

  .quantity-selector {
    display: flex;
    align-items: center;
    border: 2px solid var(--bg-alt);
    border-radius: var(--radius-sm);
    overflow: hidden;
  }

  .qty-btn {
    width: 40px;
    height: 42px;
    border: none;
    background: var(--bg-alt);
    font-size: 1.1rem;
    cursor: pointer;
    transition: background 0.2s;
    font-family: 'DM Sans', sans-serif;
    color: var(--text);
  }

  .qty-btn:hover { background: var(--cream); }

  .qty-value {
    width: 45px;
    text-align: center;
    font-weight: 600;
    font-size: 0.95rem;
  }

  .add-to-cart-btn {
    flex: 1;
    justify-content: center;
    padding: 0.9rem 2rem;
  }

  .product-perks {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .perk {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: var(--text-light);
  }

  .brewing-section {
    padding: 3rem 0;
    border-top: 1px solid var(--bg-alt);
    margin-bottom: 3rem;
  }

  .brewing-section h2 {
    margin-bottom: 1.5rem;
  }

  .brewing-recs {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .brewing-rec-card {
    padding: 1.5rem;
  }

  .brewing-rec-card h4 {
    margin-bottom: 1rem;
    color: var(--primary);
    font-size: 1rem;
  }

  .rec-specs {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
  }

  .rec-spec {
    background: var(--bg-alt);
    padding: 0.5rem;
    border-radius: var(--radius-sm);
  }

  .rec-label {
    display: block;
    font-size: 0.68rem;
    color: var(--text-light);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.1rem;
  }

  .rec-value {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--primary);
  }

  .related-section h2 {
    margin-bottom: 1.5rem;
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .related-img {
    width: 100%;
    height: 200px;
    object-fit: cover;
  }

  .related-info {
    padding: 1rem;
  }

  .related-info h4 {
    font-size: 1rem;
    margin-bottom: 0.25rem;
    color: var(--primary);
  }

  .related-roast {
    display: block;
    font-size: 0.8rem;
    color: var(--text-light);
    margin-bottom: 0.4rem;
  }

  .related-price {
    font-family: 'Lora', serif;
    font-weight: 700;
    color: var(--primary);
    font-size: 1.1rem;
  }

  @media (max-width: 768px) {
    .product-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .gallery-main-img { height: 350px; }
    .brewing-recs { grid-template-columns: 1fr; }
    .related-grid { grid-template-columns: 1fr; }
    .product-actions { flex-direction: column; }
    .add-to-cart-btn { width: 100%; }
  }
</style>
