---
const posts = [
  {
    title: "Guía de métodos de preparación",
    excerpt: "Descubre cómo cada método de preparación resalta diferentes cualidades de tu café de especialidad.",
    category: "Preparación",
    date: "15 Mar 2026",
    image: "https://images.unsplash.com/photo-1572442388796-11668a67e53d?w=500&h=300&fit=crop",
    readTime: "5 min"
  },
  {
    title: "Los mejores cafés de especialidad del Perú",
    excerpt: "Un recorrido por las regiones cafetaleras más destacadas del Perú y sus perfiles de sabor únicos.",
    category: "Origen",
    date: "8 Mar 2026",
    image: "https://images.unsplash.com/photo-1447933601403-0c6688de566e?w=500&h=300&fit=crop",
    readTime: "7 min"
  },
  {
    title: "Cómo almacenar tu café correctamente",
    excerpt: "Tips prácticos para mantener la frescura y el sabor de tu café por más tiempo después de abrirlo.",
    category: "Tips",
    date: "1 Mar 2026",
    image: "https://images.unsplash.com/photo-1509042239860-f550ce710b93?w=500&h=300&fit=crop",
    readTime: "4 min"
  },
];
---

<section class="section" id="blog">
  <div class="container">
    <h2 class="section-title">Desde el Blog</h2>
    <p class="section-subtitle">
      Conoce más sobre el mundo del café de especialidad, tips de preparación y noticias del sector.
    </p>
    <div class="blog-grid">
      {posts.map(post => (
        <article class="blog-card card">
          <div class="blog-img-wrapper">
            <img src={post.image} alt={post.title} class="blog-img" loading="lazy" />
            <span class="blog-category">{post.category}</span>
          </div>
          <div class="blog-content">
            <div class="blog-meta">
              <span>{post.date}</span>
              <span class="meta-dot">·</span>
              <span>{post.readTime} lectura</span>
            </div>
            <h3 class="blog-title">{post.title}</h3>
            <p class="blog-excerpt">{post.excerpt}</p>
            <a href="#" class="blog-link">
              Leer más
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .blog-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  .blog-img-wrapper {
    position: relative;
    overflow: hidden;
  }

  .blog-img {
    width: 100%;
    height: 200px;
    object-fit: cover;
    transition: transform 0.5s;
  }

  .blog-card:hover .blog-img {
    transform: scale(1.05);
  }

  .blog-category {
    position: absolute;
    top: 12px;
    left: 12px;
    background: var(--accent);
    color: #fff;
    font-size: 0.72rem;
    font-weight: 600;
    padding: 0.25rem 0.7rem;
    border-radius: 50px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .blog-content {
    padding: 1.25rem;
  }

  .blog-meta {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.78rem;
    color: var(--text-light);
    margin-bottom: 0.6rem;
  }

  .meta-dot { opacity: 0.5; }

  .blog-title {
    font-size: 1.05rem;
    margin-bottom: 0.5rem;
    color: var(--primary);
    line-height: 1.4;
  }

  .blog-excerpt {
    font-size: 0.88rem;
    color: var(--text-light);
    line-height: 1.6;
    margin-bottom: 1rem;
  }

  .blog-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--accent);
    text-decoration: none;
    transition: gap 0.3s;
  }

  .blog-link:hover {
    gap: 0.7rem;
    color: var(--primary-light);
  }

  @media (max-width: 768px) {
    .blog-grid { grid-template-columns: 1fr; }
  }
</style>
