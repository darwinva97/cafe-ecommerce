---
const navLinks = [
  { href: "/", label: "Inicio" },
  { href: "/productos", label: "Productos" },
  { href: "/#historia", label: "Nuestra Historia" },
  { href: "/#suscripcion", label: "Suscripción" },
  { href: "/#blog", label: "Blog" },
  { href: "/#contacto", label: "Contacto" },
];
---

<header class="header" id="header">
  <div class="container header-inner">
    <a href="/" class="logo">
      <span class="logo-icon">☕</span>
      <div class="logo-text">
        <span class="logo-name">ORIGEN CAFÉ</span>
        <span class="logo-tagline">Café de Especialidad</span>
      </div>
    </a>

    <nav class="nav" id="nav">
      <ul class="nav-list">
        {navLinks.map(link => (
          <li><a href={link.href} class="nav-link">{link.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="header-actions">
      <button class="cart-btn" aria-label="Carrito de compras">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/>
          <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
        </svg>
        <span class="cart-badge">3</span>
      </button>
      <a href="/productos" class="btn btn-primary header-cta">Comprar Ahora</a>
      <button class="mobile-toggle" id="mobileToggle" aria-label="Abrir menú">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</header>

<style>
  .header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    background: rgba(255, 253, 249, 0.95);
    backdrop-filter: blur(10px);
    transition: all 0.3s ease;
    border-bottom: 1px solid transparent;
  }

  .header.scrolled {
    background: rgba(245, 240, 232, 0.98);
    border-bottom: 1px solid rgba(200, 121, 65, 0.15);
    box-shadow: 0 2px 20px rgba(60, 26, 11, 0.06);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 72px;
    gap: 2rem;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    color: var(--primary);
    flex-shrink: 0;
  }

  .logo-icon {
    font-size: 1.6rem;
  }

  .logo-text {
    display: flex;
    flex-direction: column;
  }

  .logo-name {
    font-family: 'Lora', serif;
    font-weight: 700;
    font-size: 1.15rem;
    letter-spacing: 0.1em;
    line-height: 1.2;
  }

  .logo-tagline {
    font-size: 0.65rem;
    color: var(--text-light);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .nav-list {
    display: flex;
    list-style: none;
    gap: 0.3rem;
  }

  .nav-link {
    padding: 0.5rem 0.85rem;
    color: var(--text);
    font-size: 0.9rem;
    font-weight: 500;
    border-radius: var(--radius-sm);
    transition: all 0.3s ease;
    text-decoration: none;
  }

  .nav-link:hover {
    color: var(--accent);
    background: rgba(200, 121, 65, 0.08);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-shrink: 0;
  }

  .cart-btn {
    position: relative;
    background: none;
    border: none;
    cursor: pointer;
    color: var(--primary);
    padding: 0.4rem;
    transition: color 0.3s;
  }

  .cart-btn:hover { color: var(--accent); }

  .cart-badge {
    position: absolute;
    top: -4px;
    right: -6px;
    background: var(--accent);
    color: #fff;
    font-size: 0.65rem;
    font-weight: 700;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .header-cta {
    padding: 0.6rem 1.4rem;
    font-size: 0.85rem;
  }

  .mobile-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 4px;
  }

  .mobile-toggle span {
    width: 22px;
    height: 2px;
    background: var(--primary);
    border-radius: 2px;
    transition: all 0.3s;
  }

  @media (max-width: 960px) {
    .header-cta { display: none; }
    .mobile-toggle { display: flex; }

    .nav {
      position: fixed;
      top: 72px;
      left: 0;
      right: 0;
      background: var(--bg-alt);
      padding: 1.5rem;
      transform: translateY(-110%);
      transition: transform 0.3s ease;
      box-shadow: var(--shadow);
    }

    .nav.open {
      transform: translateY(0);
    }

    .nav-list {
      flex-direction: column;
      gap: 0.25rem;
    }

    .nav-link {
      display: block;
      padding: 0.75rem 1rem;
    }
  }
</style>

<script>
  const header = document.getElementById('header');
  const toggle = document.getElementById('mobileToggle');
  const nav = document.getElementById('nav');

  window.addEventListener('scroll', () => {
    header?.classList.toggle('scrolled', window.scrollY > 50);
  });

  toggle?.addEventListener('click', () => {
    nav?.classList.toggle('open');
  });
</script>
