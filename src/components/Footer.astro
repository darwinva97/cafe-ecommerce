---
const productLinks = [
  { href: "/productos", label: "Todos los Cafés" },
  { href: "/productos/cusco-single-origin", label: "Single Origin" },
  { href: "/#suscripcion", label: "Suscripción" },
  { href: "/productos", label: "Blend Casa" },
  { href: "/productos", label: "Accesorios" },
];

const aboutLinks = [
  { href: "/#historia", label: "Nuestra Historia" },
  { href: "/#proceso", label: "Nuestro Proceso" },
  { href: "/#blog", label: "Blog" },
  { href: "/#historia", label: "Productores" },
  { href: "/#contacto", label: "Contacto" },
];

const helpLinks = [
  { href: "#", label: "Envíos y Entregas" },
  { href: "#", label: "Devoluciones" },
  { href: "#", label: "Preguntas Frecuentes" },
  { href: "#", label: "Guía de Preparación" },
  { href: "#", label: "Términos y Condiciones" },
];
---

<footer class="footer">
  <div class="container">
    <div class="footer-top">
      <div class="footer-brand">
        <a href="/" class="footer-logo">
          <span class="footer-logo-icon">☕</span>
          <span class="footer-logo-text">ORIGEN CAFÉ</span>
        </a>
        <p class="footer-desc">
          Café de especialidad cultivado en las alturas del Perú. Tostado artesanalmente en Lima con pasión y dedicación.
        </p>
        <div class="footer-shipping">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
          <span>Envío gratis en pedidos mayores a S/ 80</span>
        </div>
        <div class="footer-socials">
          <a href="#" aria-label="Instagram" class="social-link">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
          </a>
          <a href="#" aria-label="Facebook" class="social-link">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
          </a>
          <a href="#" aria-label="TikTok" class="social-link">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5"/></svg>
          </a>
          <a href="#" aria-label="WhatsApp" class="social-link">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
          </a>
        </div>
      </div>

      <div class="footer-links-group">
        <h4>Productos</h4>
        <ul>
          {productLinks.map(link => (
            <li><a href={link.href}>{link.label}</a></li>
          ))}
        </ul>
      </div>

      <div class="footer-links-group">
        <h4>Nosotros</h4>
        <ul>
          {aboutLinks.map(link => (
            <li><a href={link.href}>{link.label}</a></li>
          ))}
        </ul>
      </div>

      <div class="footer-links-group">
        <h4>Ayuda</h4>
        <ul>
          {helpLinks.map(link => (
            <li><a href={link.href}>{link.label}</a></li>
          ))}
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <p>&copy; 2026 Origen Café. Todos los derechos reservados.</p>
      <p>Hecho con amor en Lima, Perú</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--primary);
    color: rgba(255, 255, 255, 0.85);
    padding: 4rem 0 0;
  }

  .footer-top {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1fr;
    gap: 3rem;
    padding-bottom: 3rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .footer-logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    color: #fff;
    margin-bottom: 1rem;
  }

  .footer-logo-icon { font-size: 1.4rem; }

  .footer-logo-text {
    font-family: 'Lora', serif;
    font-weight: 700;
    font-size: 1.1rem;
    letter-spacing: 0.1em;
  }

  .footer-desc {
    font-size: 0.9rem;
    line-height: 1.7;
    margin-bottom: 1.2rem;
    color: rgba(255,255,255,0.7);
  }

  .footer-shipping {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(255,255,255,0.08);
    padding: 0.6rem 1rem;
    border-radius: var(--radius-sm);
    font-size: 0.85rem;
    margin-bottom: 1.5rem;
    color: var(--accent-light);
  }

  .footer-socials {
    display: flex;
    gap: 0.75rem;
  }

  .social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: rgba(255,255,255,0.1);
    color: rgba(255,255,255,0.8);
    transition: all 0.3s;
  }

  .social-link:hover {
    background: var(--accent);
    color: #fff;
    transform: translateY(-2px);
  }

  .footer-links-group h4 {
    color: #fff;
    font-size: 0.95rem;
    font-family: 'DM Sans', sans-serif;
    font-weight: 600;
    margin-bottom: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .footer-links-group ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .footer-links-group a {
    color: rgba(255,255,255,0.6);
    font-size: 0.9rem;
    transition: color 0.3s;
    text-decoration: none;
  }

  .footer-links-group a:hover {
    color: var(--accent-light);
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.5rem 0;
    font-size: 0.82rem;
    color: rgba(255,255,255,0.4);
  }

  @media (max-width: 768px) {
    .footer-top {
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
    }
    .footer-brand {
      grid-column: 1 / -1;
    }
    .footer-bottom {
      flex-direction: column;
      gap: 0.5rem;
      text-align: center;
    }
  }

  @media (max-width: 480px) {
    .footer-top {
      grid-template-columns: 1fr;
    }
  }
</style>
