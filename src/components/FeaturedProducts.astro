---
const products = [
  {
    name: "Cusco Single Origin",
    origin: "Cusco, Quillabamba",
    roast: "Tostado medio",
    notes: "Chocolate, nuez, caramelo",
    price: 42,
    weight: "250g",
    badge: "Más vendido",
    badgeClass: "badge-popular",
    image: "https://images.unsplash.com/photo-1559056199-641a0ac8b55e?w=400&h=400&fit=crop",
    slug: "/productos/cusco-single-origin"
  },
  {
    name: "Cajamarca Reserva",
    origin: "Cajamarca, Jaén",
    roast: "Tostado oscuro",
    notes: "Cereza, cacao, especias",
    price: 48,
    weight: "250g",
    badge: "Nuevo",
    badgeClass: "badge-new",
    image: "https://images.unsplash.com/photo-1587734195503-904fca47e0e9?w=400&h=400&fit=crop",
    slug: "/productos"
  },
  {
    name: "Junín Orgánico",
    origin: "Junín, Chanchamayo",
    roast: "Tostado ligero",
    notes: "Cítricos, floral, miel",
    price: 45,
    weight: "250g",
    badge: "Orgánico",
    badgeClass: "badge-organic",
    image: "https://images.unsplash.com/photo-1611854779393-1b2da9d400fe?w=400&h=400&fit=crop",
    slug: "/productos"
  },
  {
    name: "Blend Casa",
    origin: "Blend Peruano",
    roast: "Tostado medio",
    notes: "Chocolate, caramelo",
    price: 38,
    weight: "250g",
    badge: null,
    badgeClass: "",
    image: "https://images.unsplash.com/photo-1514432324607-a09d9b4aefda?w=400&h=400&fit=crop",
    slug: "/productos"
  },
  {
    name: "Espresso Premium",
    origin: "Blend Especial",
    roast: "Tostado oscuro",
    notes: "Intenso, cacao, nuez",
    price: 44,
    weight: "250g",
    badge: "Más vendido",
    badgeClass: "badge-popular",
    image: "https://images.unsplash.com/photo-1610889556528-9a770e32642f?w=400&h=400&fit=crop",
    slug: "/productos"
  },
  {
    name: "Descafeinado Natural",
    origin: "Cusco",
    roast: "Tostado medio",
    notes: "Suave, dulce",
    price: 46,
    weight: "250g",
    badge: "Nuevo",
    badgeClass: "badge-new",
    image: "https://images.unsplash.com/photo-1498804103079-a6351b050096?w=400&h=400&fit=crop",
    slug: "/productos"
  },
];
---

<section class="section" id="productos">
  <div class="container">
    <h2 class="section-title">Nuestros Cafés</h2>
    <p class="section-subtitle">
      Granos seleccionados de las mejores regiones cafetaleras del Perú, tostados con precisión para resaltar su carácter único.
    </p>
    <div class="products-grid">
      {products.map(product => (
        <article class="product-card card">
          <div class="product-img-wrapper">
            <img src={product.image} alt={product.name} class="product-img" loading="lazy" />
            {product.badge && (
              <span class={`badge ${product.badgeClass} product-badge`}>{product.badge}</span>
            )}
          </div>
          <div class="product-info">
            <div class="product-meta">
              <span class="product-origin">{product.origin}</span>
              <span class="product-weight">{product.weight}</span>
            </div>
            <h3 class="product-name">{product.name}</h3>
            <span class="product-roast">{product.roast}</span>
            <div class="product-notes">
              <span class="notes-label">Notas:</span> {product.notes}
            </div>
            <div class="product-bottom">
              <span class="product-price">S/ {product.price}</span>
              <a href={product.slug} class="btn btn-primary product-btn">Agregar</a>
            </div>
          </div>
        </article>
      ))}
    </div>
    <div class="products-cta">
      <a href="/productos" class="btn btn-outline">Ver todos los productos</a>
    </div>
  </div>
</section>

<style>
  .products-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  .product-card {
    display: flex;
    flex-direction: column;
  }

  .product-img-wrapper {
    position: relative;
    overflow: hidden;
  }

  .product-img {
    width: 100%;
    height: 240px;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .product-card:hover .product-img {
    transform: scale(1.05);
  }

  .product-badge {
    position: absolute;
    top: 12px;
    left: 12px;
  }

  .product-info {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .product-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.4rem;
  }

  .product-origin {
    font-size: 0.78rem;
    color: var(--accent);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .product-weight {
    font-size: 0.75rem;
    color: var(--text-light);
    background: var(--bg-alt);
    padding: 0.15rem 0.5rem;
    border-radius: 50px;
  }

  .product-name {
    font-size: 1.15rem;
    margin-bottom: 0.3rem;
    color: var(--primary);
  }

  .product-roast {
    font-size: 0.82rem;
    color: var(--text-light);
    margin-bottom: 0.6rem;
  }

  .product-notes {
    font-size: 0.85rem;
    color: var(--text-light);
    margin-bottom: 1rem;
    padding-top: 0.6rem;
    border-top: 1px solid var(--bg-alt);
  }

  .notes-label {
    font-weight: 600;
    color: var(--text);
  }

  .product-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: auto;
  }

  .product-price {
    font-family: 'Lora', serif;
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--primary);
  }

  .product-btn {
    padding: 0.55rem 1.2rem;
    font-size: 0.85rem;
  }

  .products-cta {
    text-align: center;
    margin-top: 3rem;
  }

  @media (max-width: 960px) {
    .products-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 540px) {
    .products-grid { grid-template-columns: 1fr; }
  }
</style>
